{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "chmod +x mvnw && ./mvnw -B -DskipTests clean package"
  },
  "deploy": {
    "startCommand": "java -Xmx384m -jar target/wealthos-0.0.1-SNAPSHOT.jar --server.port=$PORT",
    "healthcheckPath": "/actuator/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
